generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int        @id // 1 = Rian, 2 = Wahyu (fixed)
  name               String
  heightCm           Float      @default(175)
  currentWeight      Float      @default(86)
  targetWeight       Float      @default(65)
  workoutTime        String?    @default("07:00")
  sleepTime          String?    @default("22:00")
  proteinTargetGrams Int        @default(120)
  dailyLogs          DailyLog[]
  weightLogs         WeightLog[]
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  weight    Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyLog {
  id               Int     @id @default(autoincrement())
  userId           Int
  date             String
  workout          Boolean @default(false)
  ifCompleted      Boolean @default(false)
  proteinCompleted Boolean @default(false)
  waterCompleted   Boolean @default(false)
  sleepCompleted   Boolean @default(false)
  noSnack          Boolean @default(false)
  notes            String?
  user             User    @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}