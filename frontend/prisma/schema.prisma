generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int        @id @default(autoincrement())
  firebaseUid        String?    @unique
  name               String
  email              String     @unique
  emailVerified      Boolean    @default(false)
  image              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt @default(now())
  heightCm           Float      @default(175)
  currentWeight      Float      @default(86)
  targetWeight       Float      @default(65)
  sex                String     @default("male") // male | female
  birthdate          String? // YYYY-MM-DD
  activityLevel      String     @default("moderate") // sedentary | light | moderate | active | very
  workoutTime        String?    @default("07:00")
  sleepTime          String?    @default("22:00")
  proteinTargetGrams Int        @default(120)
  calorieTarget      Int        @default(2000)
  goal               String     @default("cut") // cut | bulk
  onboardingCompleted Boolean   @default(true)
  fitnessExperience String? // beginner | intermediate | advanced
  workoutFrequency  Int? // sessions per week
  dailyLogs          DailyLog[]
  weightLogs         WeightLog[]
  mealLogs           MealLog[]
  workoutLogs        WorkoutLog[]
  fasts              Fast[]

  programEnrollments ProgramEnrollment[]
  progressPhotos     ProgressPhoto[]
  bodyMeasurements   BodyMeasurement[]
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  weight    Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyLog {
  id               Int     @id @default(autoincrement())
  userId           Int
  date             String
  workout          Boolean @default(false)
  ifCompleted      Boolean @default(false)
  proteinCompleted Boolean @default(false)
  waterCompleted   Boolean @default(false)
  sleepCompleted   Boolean @default(false)
  noSnack          Boolean @default(false)
  notes            String?
  user             User    @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model FoodItem {
  id       Int    @id @default(autoincrement())
  name     String @unique
  serving  String
  calories Float
  protein  Float
  carbs    Float
  fat      Float
}

model MealLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  mealType  String // breakfast | lunch | dinner | snack
  foodName  String
  quantity  Float    @default(1)
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model WorkoutLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  name      String // nama gerakan
  type      String // gym | calisthenics
  minutes   Int      @default(0)
  kcal      Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Fast {
  id        Int       @id @default(autoincrement())
  userId    Int
  startedAt DateTime
  endedAt   DateTime?
  planHours Int       @default(16)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgramEnrollment {
  id         Int      @id @default(autoincrement())
  userId     Int
  programId  String
  variant    String
  currentDay Int      @default(1)
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId, variant])
}

model ProgressPhoto {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  url       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyMeasurement {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  waist     Float?
  chest     Float?
  arm       Float?
  thigh     Float?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
