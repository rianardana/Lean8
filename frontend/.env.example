# Lean8 Frontend Production Environment Configuration Template
# Set this variable in Vercel Dashboard -> Settings -> Environment Variables
NEXT_PUBLIC_API_URL=https://lean8-production.up.railway.app
# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Web (Project settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings -> Service accounts -> Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Android PWA Web Push (required for closed-app notifications)
# Generate with: node scripts/generate-vapid.cjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@leanmode.app

# Vercel Cron auth for /api/cron/weekly-reminder (set same value in Vercel env; Vercel sends it as Bearer)
CRON_SECRET=
